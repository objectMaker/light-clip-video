{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Light Clip Video",
  "version": "0.1.0",
  "identifier": "cn.lightclipvideo.app",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["bin/ffmpeg.exe", "bin/ffprobe.exe"]
  }
}
