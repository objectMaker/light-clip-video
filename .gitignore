# Rust build output
/target/
**/target/

# ffmpeg sidecars (fetched at build time, not committed — ~80 MB)
/src-tauri/bin/*.exe
/src-tauri/bin/ffmpeg.exe
/src-tauri/bin/ffprobe.exe

# Logs / temp
*.log
*.tmp
*.bak

# OS noise
.DS_Store
Thumbs.db

# Tauri generated schemas (regenerated by tauri-build)
/src-tauri/gen/

# Local test artefacts
/tests/fixtures/
/output/

# Frontend build output and dependencies (rebuilt with `npm run build`)
/web/dist/
/web/node_modules/

# Local verification screenshots (never committed)
/.verify/
